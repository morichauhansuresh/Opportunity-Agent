# Default provider: Cursor Cloud Agents API.
# Keep this server-side only. Never prefix with NEXT_PUBLIC_.
CURSOR_API_KEY=your_cursor_api_key_here

# Optional. If omitted, Cursor uses your configured/default model.
# CURSOR_MODEL=your_cursor_model_id

# Optional alternative provider retained for future use.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5
